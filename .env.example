# Copy to .env and adjust.  Never commit .env.
# Real environment variables always override values in this file.

# --- Application -------------------------------------------------------------
# local | test | staging | production
OPSRAG_ENVIRONMENT=local
OPSRAG_SERVICE_NAME=opsrag-api
# DEBUG | INFO | WARNING | ERROR | CRITICAL
OPSRAG_LOG_LEVEL=INFO
# json (log aggregation) | console (human-readable)
OPSRAG_LOG_FORMAT=console
# Load the agent's models at startup (GET /api/ready waits for them). docker-compose
# turns this on for the backend; locally the first question loads them instead.
OPSRAG_PRELOAD_AGENT=false

# --- Docker (docker-compose.yml only) ----------------------------------------
# The stack runs with OPSRAG_ENVIRONMENT=production whatever is set above: set
# POSTGRES_PASSWORD and TOOLS_SQL_PASSWORD to at least 16 characters each.
# Host ports: the API, the UI, and Postgres (published on 127.0.0.1 only).
OPSRAG_API_PORT=8000
OPSRAG_UI_PORT=8501
POSTGRES_PUBLISH_PORT=5432
# Optional: an API token the UI uses when nobody signs in through the sidebar.
# Issue one after the first start: docker compose exec backend python
# scripts/create_token.py issue alex.rivera --name ui (never commit it).
OPSRAG_API_TOKEN=

# --- PostgreSQL + pgvector ---------------------------------------------------
# Shared by the API and by docker-compose's Postgres container.
# Inside docker-compose the containers override POSTGRES_HOST to "postgres".
# Prefer 127.0.0.1 over "localhost": localhost resolves to two addresses and a
# down database then takes twice the connect timeout to report.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=opsrag
# Required; never committed. Choose any value for local development (docker-compose
# refuses to start without it). In production it must be at least 16 characters, and
# the app refuses the password used by earlier local setups.
POSTGRES_PASSWORD=
POSTGRES_DB=opsrag
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=5
POSTGRES_POOL_TIMEOUT_SECONDS=10
# Minimum 2 (libpq). Bounds how long /api/health blocks when the DB is down.
POSTGRES_CONNECT_TIMEOUT_SECONDS=2
POSTGRES_ECHO_SQL=false

# --- LLM provider ------------------------------------------------------------
# none | openai | openai-compatible | ollama. "none": the agent answers with an extractive,
# fully cited summary of the evidence. The others use the OpenAI chat-completions API.
LLM_PROVIDER=none
LLM_MODEL=
# Only from the environment or a secret store; never committed. Optional for local servers.
LLM_API_KEY=
# e.g. http://localhost:11434/v1 for Ollama; empty = https://api.openai.com/v1
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_SECONDS=60

# --- Embeddings (scripts/embed.py) --------------------------------------------
# sentence-transformers (any Hugging Face sentence-embedding model) | hashing (tests only)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Expected output size; checked against the loaded model at startup.
EMBEDDING_DIMENSION=384
# cpu | cuda | mps
EMBEDDING_DEVICE=cpu
# Small batches are faster on CPU (measured: 8 beat 32 by 17-18%); raise it on a GPU.
EMBEDDING_BATCH_SIZE=8
EMBEDDING_NORMALIZE=true
# Model-specific input prefixes. bge: query instruction below; e5: "query: " / "passage: ".
EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
EMBEDDING_DOCUMENT_PREFIX=
# Empty = the model's own limit (512 tokens for bge-small); longer inputs are truncated.
EMBEDDING_MAX_SEQ_LENGTH=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# --- Retrieval ----------------------------------------------------------------
# dense | sparse (BM25) | hybrid (dense + BM25, fused) | hybrid_rerank (hybrid + cross-encoder)
RETRIEVAL_MODE=hybrid_rerank
RETRIEVAL_TOP_K=10
# pgvector HNSW candidate list (raised to at least 4 x top_k per query).
RETRIEVAL_HNSW_EF_SEARCH=100
# Fusion of dense and BM25 rankings: rrf (reciprocal rank fusion) | weighted (min-max scores).
RETRIEVAL_FUSION=rrf
# Relative weight of each retriever in the fusion; 0 disables that retriever.
RETRIEVAL_DENSE_WEIGHT=1.0
RETRIEVAL_SPARSE_WEIGHT=1.0
# RRF damping constant: fused score = sum of weight / (RRF_K + rank).
RETRIEVAL_RRF_K=60
# Results taken from each retriever before fusion.
RETRIEVAL_FUSION_DEPTH=50
# Fused candidates passed to the reranker (it returns the top RETRIEVAL_TOP_K of them).
RETRIEVAL_RERANK_CANDIDATES=30

# --- BM25 (sparse retrieval) ----------------------------------------------------
BM25_K1=1.2
BM25_B=0.75
# Snowball stemming and English stop-word removal for plain words
# (identifiers such as INC-0406 or DB_POOL_SIZE are also indexed whole).
BM25_STEMMING=true
BM25_STOPWORDS=true
# Pure identifier lookups ("MailRelayClient"): weight of the identifier's parts (mail,
# relay, client) against the whole identifier. Questions with words weight all terms 1.
BM25_PART_WEIGHT=0.75

# --- Reranker ---------------------------------------------------------------------
# cross-encoder | none (none disables reranking; then RETRIEVAL_MODE cannot be hybrid_rerank)
RERANKER_PROVIDER=cross-encoder
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANKER_DEVICE=cpu
# Pairs per forward pass; 4 measured fastest on CPU (same scores as any other size).
RERANKER_BATCH_SIZE=4
# Maximum tokens per (query, passage) pair; longer passages are truncated.
RERANKER_MAX_LENGTH=512

# --- Agent tools (app/tools) ------------------------------------------------------
# query_database connects as this read-only role (SELECT on its tables only). seed_db.py
# creates it when both are set. Required in production (and so by docker-compose, which
# defaults the user to opsrag_sql_reader); empty = the application's own connection
# (local development). The password needs at least 16 characters in production.
TOOLS_SQL_USER=
TOOLS_SQL_PASSWORD=
# Most results any search tool returns, and characters of content per result.
TOOLS_MAX_TOP_K=20
TOOLS_SNIPPET_CHARS=1500
TOOLS_RUNBOOK_MAX_CHARS=20000
# query_database: row cap and statement timeout (read-only transaction).
TOOLS_SQL_MAX_ROWS=200
TOOLS_SQL_TIMEOUT_SECONDS=5
# search_logs: result cap and the longest time window one search may cover.
TOOLS_LOGS_MAX_RESULTS=200
TOOLS_LOGS_MAX_WINDOW_DAYS=31

# --- Security (app/security, app/agents/guard.py) ------------------------------------
# Access policy (JSON): per role, which kinds of data and which labels it may read.
# Empty: the packaged app/security/policy.json. 'confidential' can never be granted.
SECURITY_POLICY_FILE=
# Retrieved content containing instructions aimed at the assistant:
# quarantine (drop the source) | redact (drop the flagged sentences, mark it suspicious).
SECURITY_INJECTION_ACTION=quarantine
# A question containing instructions aimed at the assistant: refuse | flag.
SECURITY_QUERY_INJECTION_ACTION=refuse
# Second injection detector for retrieved content: a classifier on sentences that address
# an AI. none = rules only (the rules always run).
SECURITY_INJECTION_MODEL=protectai/deberta-v3-base-prompt-injection-v2
SECURITY_INJECTION_THRESHOLD=0.9
SECURITY_INJECTION_DEVICE=cpu
# Accept the X-OpsRAG-User header (a bare user name) as identity, without a token.
# Development only: refused unless OPSRAG_ENVIRONMENT is local or test.
SECURITY_ALLOW_USER_HEADER=false

# --- Agent (app/agents) -------------------------------------------------------------
# Most tool calls per question; the agent stops earlier once its evidence goals are met.
AGENT_MAX_TOOL_CALLS=6
AGENT_RESULTS_PER_TOOL=5
# Evidence items (after reranking) passed to synthesis.
AGENT_MAX_EVIDENCE=8
# Share of the question's IDF-weighted key terms the evidence must contain; below it the
# agent says it cannot answer instead of answering from loosely related text.
AGENT_MIN_QUERY_COVERAGE=0.5
AGENT_LOG_WINDOW_PADDING_MINUTES=30
AGENT_DEFAULT_LOG_WINDOW_HOURS=24
AGENT_TIME_BUDGET_SECONDS=60
# Rerank aggregated evidence with the cross-encoder (when RERANKER_PROVIDER is set).
AGENT_RERANK_EVIDENCE=true

# --- Claim verification and confidence (app/agents/verification.py) ---------------------
# 3-way NLI cross-encoder for semantic support; none = lexical checks only.
VERIFY_NLI_MODEL=cross-encoder/nli-deberta-v3-xsmall
VERIFY_DEVICE=cpu
# Share of a claim's content terms an evidence item must contain (all its values must match).
VERIFY_SUPPORTED_THRESHOLD=0.75
VERIFY_PARTIAL_THRESHOLD=0.4
VERIFY_ENTAILMENT_THRESHOLD=0.6
VERIFY_PARTIAL_ENTAILMENT_THRESHOLD=0.3
VERIFY_CONTRADICTION_THRESHOLD=0.7
VERIFY_CONFLICT_OVERLAP=0.6
# Unsupported claims: remove | hedge | label. Partially supported: label | hedge | keep.
VERIFY_UNSUPPORTED_POLICY=remove
VERIFY_PARTIAL_POLICY=label
# Overall confidence score thresholds for HIGH and MEDIUM (below: LOW).
VERIFY_HIGH_CONFIDENCE=0.75
VERIFY_MEDIUM_CONFIDENCE=0.5

# --- Chunking (scripts/ingest.py) ------------------------------------------------
# fixed | recursive | document_aware
CHUNKING_STRATEGY=document_aware
# Approximate tokens (regex word/punctuation count). Keep well below the embedding
# model's limit (512 for bge-small): subword tokenisers produce more tokens.
CHUNKING_CHUNK_SIZE_TOKENS=350
# Used by fixed and recursive chunking, and by document-aware fallback splits.
CHUNKING_CHUNK_OVERLAP_TOKENS=50
